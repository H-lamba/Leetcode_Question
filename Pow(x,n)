## This is the solution for the given problem statement in python

class Solution(object):
    def myPow(self, x, n):
        """
        :type x: float
        :type n: int
        :rtype: float
        """
        p = 1
        if(n==0):
            return 1
        else:
            y = abs(n)
            for i in range(y):
                p = p*x
            if(n>0):
                return p
            else:
                return 1/p
